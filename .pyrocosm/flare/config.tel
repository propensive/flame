tel 1.0

# Flare checks Flame: every source, against Consequent Style, with the licence header every
# file begins with. The rules below are measured by `flare metrics` commit by commit. `make check`
# runs the profile.

rule cast
  invokes asInstanceOf
  invokes isInstanceOf
  message  Casts bypass the type checker; prefer a pattern match

rule imperative
  uses var
  uses while
  uses null
  uses return

profile default
  source src/**/*.scala

  # The `-language` features the build compiles with, so flare parses the sources exactly as
  # the build does.
  language implicitConversions
  language experimental.modularity
  language experimental.dependent

  # Kept, though the build no longer passes it: the build enables relaxed lambda syntax with
  # `-preview`, which flare cannot yet be given, so without this line flare would not parse a
  # one-line lambda such as `f: x => g(x)`.
  language experimental.relaxedLambdaSyntax
  language experimental.genericNumberLiterals
  language experimental.erasedDefinitions
  language experimental.saferExceptions
  language experimental.subCases
  language experimental.multiSpreads
  language experimental.captureChecking

  style consequent
    header etc/header.txt
    columns 100
    interpolator m
    interpolator e

  # `cast` is measured but not enforced. Every cast left is in the REPL's macros
  # (`flame.ReplMacro`, `flame.ScopeInspector`), where a value crosses between the compiler's own
  # trees and types and the Quotes API's abstract ones, or is boxed to `Object` or unboxed to a
  # spliced type in generated code: there is no runtime test a pattern match could make, and
  # every other cast has been replaced by one.
