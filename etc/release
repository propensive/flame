# What this repository's release needs that another's does not. See propensive/.github, which
# holds the workflow and the script; a release is cut by `git tag -s X.Y.Z && git push --tags`.
# One `key value` line each; the library list is not declared, because release.sh derives it
# from `release.stage`, and the version is the tag's alone.

name       flame
title      flame

build      flame.core.compile flame.web.compile flame.client.compile
launcher   flame.launcher

# The publication homes Burdock matches the classpath against by SHA-256, so that a library on
# it becomes an on-demand `Burdock-Require` URL rather than being inlined into the executable.
hints      propensive/flame,propensive/pyrocosm,propensive/soundness,propensive/proscala
