//| mill-version: 1.1.5
//| mill-jvm-version: temurin:25
//| mill-jvm-opts: ["-Xss64m", "-XX:NonProfiledCodeHeapSize=250m", "-XX:ReservedCodeCacheSize=500m"]
//| mvnDeps: ["dev.propensive:crux-mill:0.1.1"]

package build

import mill.*
import scalalib.*
// `PomSettings`, `License`, `Developer`, `VersionControl`, `PublishModule` — the Maven publishing
// vocabulary, imported exactly as the Soundness build does (`scalalib.publish.*`).
import publish.*
// crux (propensive/crux): the pinned releases on GitHub, read directly as Coursier repositories.
import crux.*

object settings:
  // The compiler is the propensive Scala fork, Proscala, at this version: pinned in `deps` below
  // like the libraries and resolved from its GitHub release by crux, which also forces every
  // `org.scala-lang` artifact to it, since the pinned libraries name the release each was built
  // with. The fork stays TASTy-compatible across its patch releases, which is what every such
  // pin assumes.
  val scalaVersion = "3.10.0-pro-1.0.2"

  // This build's version. A release's version is declared once, by its tag: the release
  // (release.sh in propensive/.github) and a snapshot (snapshot.sh) both name it in
  // `FLAME_RELEASE_VERSION`. Any other build is the version after the latest release reachable
  // from HEAD — its patch version plus one, which sorts after that release and before whichever
  // follows it — or `0.0.1` where no release tag is reachable, as in CI's shallow checkout.
  // Called from `Task.Input`s, so the environment and the tags are read on every invocation.
  def version(env: Map[String, String]): String =
    env.get("FLAME_RELEASE_VERSION").filter(_.nonEmpty).getOrElse(nextVersion)

  def nextVersion: String =
    val root = mill.api.BuildCtx.workspaceRoot

    val latest: Option[String] =
      scala.util.Try:
        os.proc("git", "describe", "--tags", "--abbrev=0", "--match", "[0-9]*.[0-9]*.[0-9]*")
        . call(cwd = root, stderr = os.Pipe).out.text().trim
      . toOption

    def numeric(part: String): Boolean = part.nonEmpty && part.forall(_.isDigit)

    latest.collect:
      case s"$major.$minor.$patch" if Seq(major, minor, patch).forall(numeric) =>
        s"$major.$minor.${patch.toInt + 1}"
    . getOrElse("0.0.1")

  val scalaOptions = Seq(
    // The fork's opt-in behaviours, enabled by name, exactly as the Soundness build enables
    // them (flame compiles the same idioms from the same TASTy): every capture-checking
    // repair, spreadable varargs, given-prefix sealing, diagnostic givens, and JSR-45 source
    // maps (formerly `-Xjsr45` — flame's own code is heavily inlined Soundness code, so
    // without the maps a frame in one of flame's classes resolves to a synthetic line).
    "-Zalias-captures",
    // NOT `-Zdiagnostic-givens` (which fume and Soundness enable): flame puts frontier on the
    // classpath so that REPL users get Soundness's missing-given advice, and under the flag
    // frontier's catch-all `soundness.explainMissingContext` given turns a TENTATIVE implicit
    // search — one made while a type parameter is still undetermined, as `join`'s `element`
    // or `flatMap`'s `Reshapable by …` are — into a hard error instead of a failed candidate
    // the compiler retries after inference. The REPL passes the flag per line (see
    // `Repl.effectiveScalac`); flame's own sources compile without it.
    "-Zgiven-prefixes",
    "-Zinline-source-maps",
    "-Zopaque-mutability",
    "-Zpure-iarrays",
    "-Zfrozen-pure",
    "-Zretains-bounds",
    "-Zretains-skolems",
    "-Zspreadable-varargs",
    "-Zunboxed-pure-types",
    "-Zunion-captures",
    "-experimental",
    "-new-syntax",
    "-feature",
    "-preview",
    "-deprecation",
    "-Wunused:imports",
    "-Wimplausible-patterns",
    "-Xmax-inlines", "32",
    "-Yno-flexible-types",
    "-Yexplicit-nulls",
    "-Ycheck-all-patmat",
    "-language:experimental.modularity",
    "-language:experimental.dependent",
    "-language:experimental.genericNumberLiterals",
    "-language:experimental.erasedDefinitions",
    "-language:implicitConversions",
    "-language:experimental.saferExceptions",
    "-language:experimental.subCases",
    "-language:experimental.multiSpreads",
    // Capture checking, as enabled throughout Soundness: the language flag is equivalent to a
    // per-file `import language.experimental.captureChecking`, so no source edits are needed.
    // Separation checking (fume's `-language:experimental.separationChecking`, Soundness's
    // strictest tier) is NOT enabled: the REPL's compile pipeline threads `Tactic` capabilities
    // through context-function result types in a way the separation checker rejects.
    "-Ycc-new",
    "-language:experimental.captureChecking"
  )

  // Fume's sources are written for the proscenium predef (the soundness house
  // predef), so the standalone build replicates `-Yno-predef -Yimports:…`.
  // `scala` is deliberately NOT imported (as of Soundness #1693): the blessed collections are
  // proscenium's opaque `List`/`Set`/`Map`/`Array`, and naming both packages would make every
  // such reference ambiguous. Stdlib collections must announce themselves with an explicit
  // `scala.`-qualified name or import, and cross the boundary through `proscenium.compat`.
  val predef = Seq("-Yno-predef", "-Yimports:java.lang,proscenium")

  // Soundness publishes COMPONENTS again (Soundness #1929): each tagged version is a GitHub
  // release whose assets are the individual component jars, and the bundles — including the
  // `dev.propensive:soundness` universal aggregate flame used to depend on — are no longer
  // published. Every released jar embeds its own POM and ivy.xml (`META-INF/maven/…`), and
  // `make sync-releases VERSION=X.Y.Z` in the Soundness repository installs a release into
  // `~/.ivy2/local` (Soundness #1933), from which coursier resolves these coordinates with no
  // repository configuration. Component jars carry no `_3` suffix, hence the single-colon
  // `mvn"…"`.
  //
  // Each list names TOP-LEVEL components only: each jar's embedded POM names its own
  // dependencies, so the rest of the surface `import soundness.*` touches arrives transitively.
  def component(soundness: String)(name: String): Dep = mvn"dev.propensive:$name:$soundness"

  // The REPL session classpath. Everything `core` itself compiles against, and — because a
  // Flame user's `import soundness.*` can only reach what is on the session's compile+run
  // classpath — a curated set of the everyday Soundness libraries on top. There is no longer a
  // universal artifact to take instead, and the full set of ~280 components would be a very
  // large first-run download, so this list is deliberately a selection; extend it as needed.
  def coreDeps(soundness: String) = Seq(
    // What flame's own `core` sources use:
    "anthology-scala",       // Scalac[3.9, …]: driving the compiler
    "hyperbole-core",        // /tasty: TASTy tree rendering
    "hyperbole-tasty",
    "hyperbole-stacks",      // TASTy-backed stack-trace resolution
    "mandible-core",         // /bytecode: classfile disassembly
    "delicious-core",        // -Xsemantic-diagnostics markup
    "delicious-scala",       // the TASTy-unpickling Reifier
    "delicious-ansi",
    "stenography-core",      // type rendering
    "prophesy-core",         // keyword completions
    "harlequin-core",        // syntax highlighting
    "harlequin-typed",       // highlighting.typecheckedScala (moved out of harlequin-core in 0.69.0)
    "hellenism-jvm",         // classpaths and classloaders
    "escapade-core",         // Teletype output
    "iridescence-core",      // colours
    "digression-ansi",       // stack traces
    "eucalyptus-core",       // logging
    "galilei-jvm",           // the filesystem
    "coaxial-jvm",           // sockets, for sessions
    "urticose-core",         // ports and hostnames
    "capricious-core",       // randomness
    "parasite-jvm",          // async
    "turbulence-stdio",      // Stdio
    "stratiform-core",
    "obligatory-core",       // LengthPrefix: the session protocol's record framing
    "distillate-core",
    "spectacular-core",      // /inspect
    "inimitable-core",       // Uuid
    "nomenclature-core",
    "nomenclature-lexicon",   // the session-name word list
    "ambience-core",         // System properties and the environment
    "aperture-core",
    "denominative-core",
    "hieroglyph-core",       // character encodings
    "tessellate-core",       // Flow.wrap: word-wrapping a diagnostic's prose
    // Everyday libraries a REPL user expects from `import soundness.*`:
    "gossamer-core", "rudiments-core", "contingency-core", "vacuous-core", "aviation-core",
    "quantitative-core", "quantitative-units", "hypotenuse-core", "kaleidoscope-core",
    "wisteria-core", "jacinta-core", "xylophone-core", "caesura-core", "gastronomy-core",
    "guillotine-core", "telekinesis-jvm", "urticose-url", "honeycomb-core", "cataclysm-core",
    "probably-core", "escapade-io", "imperial-core", "serpentine-core",
    // Rich media, which the web front-end shows as images and drawings (see `pyrocosm-media`):
    "hallucination-core", "hallucination-formats", "savagery-core", "escapade-graphics",
    "anticipation-gfx", "monotonous-core")
  . map(component(soundness))

  def pyrocosmCoreDeps(pyrocosm: String) = Seq(
    mvn"dev.propensive:pyrocosm-model:$pyrocosm",
    mvn"dev.propensive:pyrocosm-compiler:$pyrocosm",
    mvn"dev.propensive:pyrocosm-media:$pyrocosm")

  def clientDeps(soundness: String) = Seq(
    "ethereal-core",             // the daemon
    "exoskeleton-completions",   // execute + tab-completion
    "profanity-core",            // the terminal and line editor
    "ultimatum-core",            // panes and layout
    "zephyrine-core",            // streams over the session socket
    "obligatory-core",           // LengthPrefix: the session protocol's record framing
    "urticose-core",
    "escapade-core",
    "iridescence-core",
    "harlequin-ansi",
    "coaxial-jvm",
    "burdock-core",              // externalize + the repackager
    "burdock-boot")              // the Bootstrap class the repackager force-includes
  . map(component(soundness))

  // The web front-end: an HTTP server (scintillate), WebSockets (perihelion), HTML (honeycomb)
  // and the page `Archetype` (graffiti).
  def webDeps(soundness: String) = Seq(
    "scintillate-server", "perihelion-core", "honeycomb-core", "graffiti-core", "archimedes-core",
    "jacinta-core")
  . map(component(soundness))

  // probably-events carries `probably.Streamer`, the BinTEL event stream fume drives a suite
  // through; without it fume falls back to a legacy run that no longer exists in 0.65.0.
  def testDeps(soundness: String) = Seq("probably-cli", "probably-events", "fulminate-core").map(component(soundness))

  // What a build of flame identifies itself as, written into the client jar as
  // `META-INF/pyrocosm/flame/version` for `pyrocosm-cli` to read (`flame about`,
  // `flame --version`): the version a release or snapshot is published as, when
  // `FLAME_RELEASE_VERSION` names it (`make snapshot` and the release both set it); otherwise
  // the next version (`nextVersion`) with the filtered tree hash of HEAD — the identity `make snapshot` would
  // give this commit — and `-dirty` if the working tree has changes that no commit records.
  // Called from a `Task.Input`, so that HEAD is consulted on every invocation.
  def buildVersion(env: Map[String, String]): String =
    env.get("FLAME_RELEASE_VERSION").filter(_.nonEmpty).getOrElse:
      val root = mill.api.BuildCtx.workspaceRoot

      val tree: String =
        scala.util.Try(os.proc("./etc/shared", "filtered_tree.py", "HEAD").call(cwd = root).out.text().trim)
          .getOrElse(os.proc("git", "rev-parse", "HEAD^{tree}").call(cwd = root).out.text().trim)

      val dirty: Boolean = os.proc("git", "status", "--porcelain").call(cwd = root).out.text().trim.nonEmpty
      s"$nextVersion-${tree.take(12)}${if dirty then "-dirty" else ""}"

// The propensive libraries this build depends on, pinned in etc/refs (the format, the snapshot flow
// and the shared scripts are documented in propensive/.github): each is a release `X.Y.Z`, or a
// snapshot `X.Y.Z-<12 hex>` of an unreleased upstream build, published there by `make snapshot`.
// crux resolves each — and, transitively, what each was built against — from its GitHub release;
// nothing is installed locally. The Proscala pin is declared here rather than in etc/refs, which
// deps.py (propensive/.github) also reads and which does not yet know the form of a Proscala
// version. The file is read as a source, so editing it invalidates every resolution.
object deps extends CruxModule:
  def refsFiles = Task.Sources(mill.api.BuildCtx.workspaceRoot / "etc" / "refs")
  def declared = Seq(Pin("propensive/proscala", settings.scalaVersion))

  def soundness: T[String] = Task(version("soundness")())
  def pyrocosm: T[String] = Task(version("pyrocosm")())

// A module compiled with the pinned fork, against the pinned libraries.
trait Fork extends CruxScalaModule:
  def crux = deps

trait Project extends Module:
  def moduleDir = super.moduleDir / os.up / "src"

// Dependencies are typed `PublishModule*` (as in the Soundness build) so that `moduleDeps` can
// return `Seq[PublishModule]` — the type `SonatypeCentralPublishModule` requires of the modules that
// mix in `Publishing`. All of flame's inter-module dependencies (`core`, `web`) are published, so
// this costs the unpublished modules (`launcher`, `test`) nothing.
trait Component(dependencies: PublishModule*) extends Fork:
  override def scalacOptions = settings.scalaOptions ++ settings.predef

  // The beneficence plugin writes `META-INF/givens/<typeclass>` and `META-INF/services/probably.Suite`
  // into every module that contributes an entry, so each is a *fragment* of a build-wide index rather
  // than a whole file. Mill's default assembly rules are last-one-wins, which silently truncates them:
  // now that flame's Soundness dependency arrives as eight bundle jars — which collide on 66 such
  // entries — the givens index would lose almost everything, and `beneficence` reads it at runtime
  // through `getResources`. Concatenate instead, exactly as the Soundness build does (`mergeRules`).
  // Every fragment ends with a newline, so the empty separator is correct.
  override def assemblyRules = super.assemblyRules ++ Seq(
    mill.javalib.Assembly.Rule.AppendPattern("META-INF/givens/.*"),
    mill.javalib.Assembly.Rule.AppendPattern("META-INF/services/.*"))
  def moduleId: String = moduleDir.last
  def moduleDeps: Seq[PublishModule] = dependencies
  def sources = Task.Sources(moduleDir)

// Mixed into the library modules that are released (`core`, `web`, `client`) — the modules the
// `launcher` then pulls back in as published coordinates. Releases go to GitHub Releases (see
// release.sh in propensive/.github), with `publishLocal` producing the jars and their
// POMs; the Sonatype module is retained only for its POM machinery. Every setting mirrors the
// Soundness build: the same `dev.propensive` organization, URL, Apache-2.0 licence, GitHub SCM and
// developer, plus the empty `-javadoc.jar`. A module's `moduleDeps` that are themselves
// `Publishing` become POM `<dependency>` entries, so the published `flame-client` correctly
// declares `flame-core`/`flame-web`.
trait Publishing extends Fork, SonatypeCentralPublishModule:
  // A `Task.Input` reading `Task.env`, not a plain value: `FLAME_RELEASE_VERSION` is how a
  // release and `make snapshot` (release.sh and snapshot.sh in propensive/.github) drive the
  // version through a Mill daemon that is already running — the daemon freezes `sys.env` at its
  // own start, while `Task.env` is the environment of each `./mill` invocation. Without it, the
  // version is `settings.nextVersion`. The launcher resolves this module at this same version.
  def publishVersion = Task.Input:
    settings.version(Task.env)
  def artifactSuffix = Task("")

  def pomSettings = Task(PomSettings(
    description = "flame",
    organization = "dev.propensive",
    url = "https://soundness.dev/",
    licenses = Seq(License.`Apache-2.0`),
    versionControl = VersionControl.github("propensive", "flame"),
    developers = Seq(Developer("propensive", "Jon Pretty", "https://github.com/propensive"))))

  override def docJar = Task:
    val jar = Task.dest / "empty.jar"
    val zos = new java.util.zip.ZipOutputStream(new java.io.FileOutputStream(jar.toIO))
    zos.close()
    PathRef(jar)

object flame extends Project:
  // The REPL engine. Depends on the Scala 3 compiler (it compiles user input) in addition to its
  // Soundness components. Released as `dev.propensive:flame-core`.
  object core extends Component(), Publishing:
    def mvnDeps = Task:
      settings.coreDeps(deps.soundness()) ++ settings.pyrocosmCoreDeps(deps.pyrocosm())
        :+ mvn"org.scala-lang:scala3-compiler_3:${settings.scalaVersion}"

    // frontier — `soundness.explainMissingContext`, the `@internal.diagnostic` catch-all given
    // that renders Soundness's missing-given advice — is a RUNTIME dependency only: it must be on
    // the REPL session classpath (which is this module's runtime classpath), but flame's own
    // sources have no use for it at compile time. (Before Soundness 0.65.0 it also had to be kept
    // OFF the compile classpath, where the catch-all satisfied tentative implicit searches —
    // `join`'s element type, `flatMap`'s reshaping — with `Any`; Soundness #1944 made the candidate
    // always fail, so that hazard is gone, but there is still no reason to compile against it.)
    def runMvnDeps = Task(Seq(settings.component(deps.soundness())("frontier-core")))

  // The interactive client library (`flame.Client.run` and its helpers). NO LONGER an assembled app:
  // the `@main`/`externalize` entry point moved to the `launcher` module, so this is a plain library
  // released as `dev.propensive:flame-client`. Depends on `core` and `web` (so
  // `flame serve` can launch the web front-end in-process); those become `flame-core`/`flame-web`
  // POM dependencies, and the web front-end's Soundness deps come transitively. `pyrocosm-cli`
  // supplies the standard command line every Pyrocosm tool shares (`Tool` — `flame about`,
  // `install`, `quit`, `--version` and the `config.tel` files).
  object client extends Component(core, web), Publishing:
    def mvnDeps = Task:
      settings.clientDeps(deps.soundness())
      :+ mvn"dev.propensive:pyrocosm-terminal:${deps.pyrocosm()}"
      :+ mvn"dev.propensive:pyrocosm-cli:${deps.pyrocosm()}"

    // Flame's own version, as `flame about` and `flame --version` report it: see
    // `settings.buildVersion`. Written into THIS module's resources, since the `Tool` descriptor
    // lives here and the resource is read through the thread's context classloader, which sees
    // the client jar under Burdock.
    def buildVersion = Task.Input(settings.buildVersion(Task.env))

    override def resources = Task:
      val file = Task.dest / "META-INF" / "pyrocosm" / "flame" / "version"
      os.write.over(file, buildVersion() + "\n", createFolders = true)
      super.resources() ++ Seq(PathRef(Task.dest))

  // An alternative, web-based front-end (`flame.web`): serves a page and forwards REPL input/output
  // over a WebSocket, driving the same `core` engine as the CLI client. Published as
  // `dev.propensive:flame-web`; still assembled directly by `make web`, hence `finalMainClass`.
  object web extends Component(core), Publishing:
    def mvnDeps = Task:
      settings.webDeps(deps.soundness()) :+ mvn"dev.propensive:pyrocosm-web:${deps.pyrocosm()}"
    def finalMainClass = "flame.web"
    def prependShellScript = ""

  // The invocation point, ALONE in its own module (`src/launcher/flame_launcher.scala` — just the
  // `@main def repl = externalize(Client.run())`). It depends on `client`/`core`/`web` NOT as Mill
  // `moduleDeps` but as PUBLISHED coordinates, so coursier puts the byte-identical released jars
  // on the compile classpath that `externalize` hashes; the repackager then externalizes them into
  // on-demand downloads instead of inlining. `flame-client`'s POM pulls `flame-core`/`flame-web`
  // (and the Soundness components) transitively; burdock is also named explicitly because the
  // `externalize` macro and the `soundness.repackage` main are compiled/run against it.
  //
  // NOTE: `flame-client` resolves from `~/.ivy2/local`, so a `publishLocal` must precede this
  // module's assembly (`make run` does so). Externalization happens only in a release, once
  // the same bytes are a GitHub release asset (a local copy alone would be inlined).
  object launcher extends Component():
    // `frontier-core` is only a RUNTIME dependency of `core`, so it would be missing from this
    // module's compile classpath, which is what `externalize` hashes; the repackager would then
    // inline it rather than externalize it. Naming it here lets it be externalized like the rest.
    def mvnDeps = Task:
      mvn"dev.propensive:flame-client:${client.publishVersion()}" +: settings.clientDeps(deps.soundness())
      :+ settings.component(deps.soundness())("frontier-core")
    def finalMainClass = "flame.repl"
    // A clean zip (no executable shell preamble) so the Burdock repackager can read and rewrite the
    // assembled JAR.
    def prependShellScript = ""

  // The beneficence plugin runs on this module so that its `Suite` lands in the assembly's
  // `META-INF/services/probably.Suite` index, which is how `fume run` (configured by
  // .pyrocosm/fume/config.tel) discovers it. `flame.runTests` is the plain-`java` fallback the shared CI
  // workflow uses, driving `Tests.invoke` in-process.
  object test extends Component(core):
    def mvnDeps = Task(settings.testDeps(deps.soundness()))
    def scalacPluginMvnDeps = Task(Seq(mvn"dev.propensive:beneficence-plugin:${deps.soundness()}"))
    def finalMainClass = "flame.runTests"

// The release: the library modules' jars, each with its POM and ivy.xml embedded under
// `META-INF/maven/<group>/<artifactId>/`, named `<artifactId>-<version>.jar`, exactly as the
// Soundness and Pyrocosm builds stage theirs. A jar so staged is all a consumer needs: the shared
// sync script (propensive/.github) reconstructs the ivy2 layout coursier resolves from, which is
// how `make snapshot` publishes an unreleased build for a dependent repository to pin.
object release extends Module:
  def modules: Seq[PublishModule] = Seq(flame.core, flame.web, flame.client)

  private def withDescriptors(source: os.Path, target: os.Path, entries: Seq[(String, os.Path)])
  :   Unit =
    val input = new java.util.zip.ZipFile(source.toIO)
    val output = new java.util.zip.ZipOutputStream(new java.io.FileOutputStream(target.toIO))
    try
      val existing = input.entries()
      while existing.hasMoreElements do
        val entry = existing.nextElement()
        output.putNextEntry(new java.util.zip.ZipEntry(entry.getName))
        if !entry.isDirectory then input.getInputStream(entry).transferTo(output)
        output.closeEntry()

      for (name, file) <- entries do
        output.putNextEntry(new java.util.zip.ZipEntry(name))
        output.write(os.read.bytes(file))
        output.closeEntry()
    finally
      output.close()
      input.close()

  // The ivy.xml published beside each jar as `<artifactId>-<version>.ivy.xml`: the metadata
  // Coursier reads when crux (propensive/crux) uses the release as an Ivy-pattern repository,
  // without the sources and javadoc publications. Mill declares those in the `compile`
  // configuration too, and the crux artifact pattern names the main jar for any publication
  // without a classifier, so left in place they would resolve to the jar itself.
  private def stripDescriptor(ivy: String): String =
    val artifact = """<artifact\b[^>]*?(?:/>|>\s*</artifact>)""".r
    val filtered = artifact.replaceAllIn(ivy, found =>
      if found.matched.contains("classifier=") || found.matched.matches("""(?s).*\btype="(src|doc)".*""")
      then "" else java.util.regex.Matcher.quoteReplacement(found.matched))
    filtered.linesIterator.filter(_.trim.nonEmpty).mkString("", "\n", "\n")

  def stage: T[Seq[PathRef]] = Task:
    val jars: Seq[(PathRef, String, String, String, PathRef, PathRef)] =
      Task.traverse(modules)(module =>
        Task.Anon((module.jar(), module.pomSettings().organization, module.artifactId(),
                   module.publishVersion(), module.pom(), module.ivy())))()

    jars.flatMap: (jar, group, artifactId, version, pom, ivy) =>
      val target = Task.dest / s"$artifactId-$version.jar"
      val prefix = s"META-INF/maven/$group/$artifactId"
      val descriptors = Seq(s"$prefix/pom.xml" -> pom.path, s"$prefix/ivy.xml" -> ivy.path)
      withDescriptors(jar.path, target, descriptors)
      val metadata = Task.dest / s"$artifactId-$version.ivy.xml"
      os.write.over(metadata, stripDescriptor(os.read(ivy.path)))
      Seq(PathRef(target), PathRef(metadata))
