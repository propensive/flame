//| mill-version: 1.1.5
//| mill-jvm-version: temurin:25
//| mill-jvm-opts: ["-XX:NonProfiledCodeHeapSize=250m", "-XX:ReservedCodeCacheSize=500m"]

package build

import mill.*
import scalalib.*
// `PomSettings`, `License`, `Developer`, `VersionControl`, `PublishModule` — the Maven publishing
// vocabulary, imported exactly as the Soundness build does (`scalalib.publish.*`).
import publish.*

object settings:
  // The locally-built Scala compiler from the propensive/scala fork — the same toolchain
  // Soundness itself builds with since capture checking was enabled throughout (#1498).
  // Soundness's TASTy is produced by this compiler, so flame must compile with it too.
  // `SOUNDNESS_SCALA_VERSION`/`SOUNDNESS_SCALA_HOME` switch toolchains together, exactly as
  // in the Soundness build.
  //
  // NOTE these two `sys.env` overrides do NOT work under Mill: the value is read when the build
  // script is evaluated, and neither a fresh daemon nor `--no-daemon` propagates the variable. To
  // switch toolchains, edit the defaults here.
  val scalaVersion = sys.env.getOrElse("SOUNDNESS_SCALA_VERSION", "3.9.0-p16")
  // The propensive/proscala release the toolchain jars are downloaded from (unless a local
  // `SOUNDNESS_SCALA_HOME` is set), exactly as in the Soundness build. The two MAY differ (the
  // synthetic repository below republishes whatever the release ships under `scalaVersion`), but
  // the pair must be kept in step with Soundness's own, or flame would compile against a different
  // compiler build from the one that produced the Soundness TASTy it reads.
  val scalaRelease = sys.env.getOrElse("SOUNDNESS_SCALA_RELEASE", "3.9.0-p16")
  // Empty by default → download `scalaRelease`. Set to a local `make`-built `release` directory
  // to use its `release/lib` jars directly (fork-developer mode).
  val scalaHome = sys.env.getOrElse("SOUNDNESS_SCALA_HOME", "")

  val soundnessVersion = "0.65.0"

  // The version flame's OWN library modules (`flame-core`, `flame-web`, `flame-client`) are
  // released under, AND the version the `launcher` module resolves them at. Kept as a single value
  // so the released coordinates and the launcher's dependency coordinates cannot drift apart:
  // burdock externalizes a module only when the exact released jar bytes are on the launcher's
  // classpath, so a mismatch would silently fall back to inlining. Bump (and commit) per release;
  // etc/ci/release.sh refuses to release when this pin disagrees with its VERSION argument.
  val flameVersion = sys.env.getOrElse("FLAME_VERSION", "0.1.2")

  // The Pyrocosm release the user interface is built on: the model (and its compiler-facing
  // exhibitions) in core, the terminal frontend in the client, the web frontend in web.
  // Resolved from `~/.ivy2/local` like the Soundness components: installed from Pyrocosm's
  // GitHub Releases by the shared CI workflow's `extra_releases` input, or locally by
  // Soundness's sync script pointed at Pyrocosm, or by `make publishLocal` there.
  val pyrocosmVersion = "0.1.0"

  val scalaOptions = Seq(
    // The fork's opt-in behaviours, enabled by name, exactly as the Soundness build enables
    // them (flame compiles the same idioms from the same TASTy): every capture-checking
    // repair, spreadable varargs, given-prefix sealing, diagnostic givens, and JSR-45 source
    // maps (formerly `-Xjsr45` — flame's own code is heavily inlined Soundness code, so
    // without the maps a frame in one of flame's classes resolves to a synthetic line).
    "-Zalias-captures",
    // NOT `-Zdiagnostic-givens` (which fume and Soundness enable): flame puts frontier on the
    // classpath so that REPL users get Soundness's missing-given advice, and under the flag
    // frontier's catch-all `soundness.explainMissingContext` given turns a TENTATIVE implicit
    // search — one made while a type parameter is still undetermined, as `join`'s `element`
    // or `flatMap`'s `Reshapable by …` are — into a hard error instead of a failed candidate
    // the compiler retries after inference. The REPL passes the flag per line (see
    // `Repl.effectiveScalac`); flame's own sources compile without it.
    "-Zgiven-prefixes",
    "-Zinline-source-maps",
    "-Zopaque-mutability",
    "-Zpure-iarrays",
    "-Zretains-bounds",
    "-Zretains-skolems",
    "-Zspreadable-varargs",
    "-Zunboxed-pure-types",
    "-Zunion-captures",
    "-experimental",
    "-new-syntax",
    "-feature",
    "-preview",
    "-deprecation",
    "-Wunused:imports",
    "-Wimplausible-patterns",
    "-Xmax-inlines", "32",
    "-Yno-flexible-types",
    "-Yexplicit-nulls",
    "-Ycheck-all-patmat",
    "-language:experimental.modularity",
    "-language:experimental.dependent",
    "-language:experimental.relaxedLambdaSyntax",
    "-language:experimental.genericNumberLiterals",
    "-language:experimental.into",
    "-language:experimental.erasedDefinitions",
    "-language:implicitConversions",
    "-language:experimental.saferExceptions",
    "-language:experimental.strictEqualityPatternMatching",
    "-language:experimental.subCases",
    "-language:experimental.multiSpreads",
    // Capture checking, as enabled throughout Soundness: the language flag is equivalent to a
    // per-file `import language.experimental.captureChecking`, so no source edits are needed.
    // Separation checking (fume's `-language:experimental.separationChecking`, Soundness's
    // strictest tier) is NOT enabled: the REPL's compile pipeline threads `Tactic` capabilities
    // through context-function result types in a way the separation checker rejects.
    "-Ycc-new",
    "-language:experimental.captureChecking"
  )

  // Fume's sources are written for the proscenium predef (the soundness house
  // predef), so the standalone build replicates `-Yno-predef -Yimports:…`.
  // `scala` is deliberately NOT imported (as of Soundness #1693): the blessed collections are
  // proscenium's opaque `List`/`Set`/`Map`/`Array`, and naming both packages would make every
  // such reference ambiguous. Stdlib collections must announce themselves with an explicit
  // `scala.`-qualified name or import, and cross the boundary through `proscenium.compat`.
  val predef = Seq("-Yno-predef", "-Yimports:java.lang,proscenium")

  // Soundness publishes COMPONENTS again (Soundness #1929): each tagged version is a GitHub
  // release whose assets are the individual component jars, and the bundles — including the
  // `dev.propensive:soundness` universal aggregate flame used to depend on — are no longer
  // published. Every released jar embeds its own POM and ivy.xml (`META-INF/maven/…`), and
  // `make sync-releases VERSION=X.Y.Z` in the Soundness repository installs a release into
  // `~/.ivy2/local` (Soundness #1933), from which coursier resolves these coordinates with no
  // repository configuration. Component jars carry no `_3` suffix, hence the single-colon
  // `mvn"…"`.
  //
  // Each list names TOP-LEVEL components only: each jar's embedded POM names its own
  // dependencies, so the rest of the surface `import soundness.*` touches arrives transitively.
  def component(name: String): Dep = mvn"dev.propensive:$name:$soundnessVersion"

  // The REPL session classpath. Everything `core` itself compiles against, and — because a
  // Flame user's `import soundness.*` can only reach what is on the session's compile+run
  // classpath — a curated set of the everyday Soundness libraries on top. There is no longer a
  // universal artifact to take instead, and the full set of ~280 components would be a very
  // large first-run download, so this list is deliberately a selection; extend it as needed.
  val coreDeps = Seq(
    // What flame's own `core` sources use:
    "anthology-scala",       // Scalac[3.9, …]: driving the compiler
    "hyperbole-core",        // /tasty: TASTy tree rendering
    "hyperbole-tasty",
    "hyperbole-stacks",      // TASTy-backed stack-trace resolution
    "mandible-core",         // /bytecode: classfile disassembly
    "delicious-core",        // -Xsemantic-diagnostics markup
    "delicious-scala",       // the TASTy-unpickling Reifier
    "delicious-ansi",
    "stenography-core",      // type rendering
    "prophesy-core",         // keyword completions
    "harlequin-core",        // syntax highlighting
    "hellenism-jvm",         // classpaths and classloaders
    "escapade-core",         // Teletype output
    "iridescence-core",      // colours
    "digression-ansi",       // stack traces
    "eucalyptus-core",       // logging
    "galilei-jvm",           // the filesystem
    "coaxial-jvm",           // sockets, for sessions
    "urticose-core",         // ports and hostnames
    "capricious-core",       // randomness
    "parasite-jvm",          // async
    "turbulence-stdio",      // Stdio
    "stratiform-core",
    "stratiform-binary",     // BinTEL, the session wire format
    "distillate-core",
    "spectacular-core",      // /inspect
    "inimitable-core",       // Uuid
    "nomenclature-core",
    "nomenclature-lexicon",   // the session-name word list
    "ambience-core",         // System properties and the environment
    "aperture-core",
    "denominative-core",
    "hieroglyph-core",       // character encodings
    // Everyday libraries a REPL user expects from `import soundness.*`:
    "gossamer-core", "rudiments-core", "contingency-core", "vacuous-core", "aviation-core",
    "quantitative-core", "quantitative-units", "hypotenuse-core", "kaleidoscope-core",
    "wisteria-core", "jacinta-core", "xylophone-core", "caesura-core", "gastronomy-core",
    "guillotine-core", "telekinesis-jvm", "urticose-url", "honeycomb-core", "cataclysm-core",
    "probably-core", "escapade-io", "imperial-core", "serpentine-core")
  . map(component)

  val pyrocosmCoreDeps = Seq(
    mvn"dev.propensive:pyrocosm-model:$pyrocosmVersion",
    mvn"dev.propensive:pyrocosm-compiler:$pyrocosmVersion")

  val clientDeps = Seq(
    "ethereal-core",             // the daemon
    "exoskeleton-completions",   // execute + tab-completion
    "profanity-core",            // the terminal and line editor
    "ultimatum-core",            // panes and layout
    "zephyrine-core",            // streams over the session socket
    "urticose-core",
    "escapade-core",
    "iridescence-core",
    "harlequin-ansi",
    "coaxial-jvm",
    "burdock-core",              // externalize + the repackager
    "burdock-boot",              // the Bootstrap class the repackager force-includes
    "ziggurat-core")             // Xeq.dispatcher, for releases
  . map(component)

  // The web front-end: an HTTP server (scintillate), WebSockets (perihelion), HTML (honeycomb)
  // and the page `Archetype` (graffiti).
  val webDeps = Seq(
    "scintillate-server", "perihelion-core", "honeycomb-core", "graffiti-core", "archimedes-core",
    "jacinta-core")
  . map(component)

  // probably-events carries `probably.Streamer`, the BinTEL event stream fume drives a suite
  // through; without it fume falls back to a legacy run that no longer exists in 0.65.0.
  val testDeps = Seq("probably-cli", "probably-events", "fulminate-core").map(component)

// Exposes the fork compiler's `release/lib` jars (from a local build via `settings.scalaHome`, or
// downloaded from the `settings.scalaRelease` GitHub release) as a Maven-layout repository,
// generated on demand into the task's own dest: the unversioned jars are copied to versioned
// coordinates with minimal POMs. Ported (JVM artifacts only) from the Soundness build, whose
// published TASTy this toolchain produced.
object toolchain extends Module:
  // Downloads and extracts the `settings.scalaRelease` tarball from propensive/proscala into a
  // *shared* cache dir outside the Mill `out/` tree — the same cache the Soundness build uses, so
  // a release fetched by either build is reused by the other. Each release is a single
  // `proscala-<tag>.tar.gz` asset carrying a `lib/` directory of jars, extracted here into
  // `<tag>/lib`. A `.complete` sentinel makes a fully-populated cache a no-op — no network, no
  // GitHub API call. Returns the `lib` dir.
  def downloadRelease(tag: String): os.Path =
    val root = os.home / ".cache" / "soundness" / "proscala" / tag
    val lib = root / "lib"
    val sentinel = lib / ".complete"
    if os.exists(sentinel) then lib else
      os.makeDir.all(root)
      val api = s"https://api.github.com/repos/propensive/proscala/releases/tags/$tag"
      val json = ujson.read(os.proc("curl", "-fsSL", api).call().out.text())
      val asset = json("assets").arr.find(_("name").str.endsWith(".tar.gz")).getOrElse:
        throw new Exception(s"no .tar.gz asset on proscala release $tag")
      val name = asset("name").str
      val url = asset("browser_download_url").str
      val tarball = root / name
      if !os.exists(tarball) then
        os.proc("curl", "-fsSL", "-o", tarball.toString, url).call()
      // Verify against the published digest when the API supplies one ("sha256:<hex>").
      asset.obj.get("digest").flatMap(_.strOpt).foreach: digest =>
        if digest.startsWith("sha256:") then
          val md = java.security.MessageDigest.getInstance("SHA-256")
          val hex = md.digest(os.read.bytes(tarball)).map("%02x".format(_)).mkString
          if hex != digest.stripPrefix("sha256:") then
            os.remove(tarball)
            throw new Exception(s"checksum mismatch for $name (expected $digest, got sha256:$hex)")
      // The tarball carries a `lib/` prefix, so extracting into `<tag>` lands the jars at
      // `<tag>/lib/*.jar`. Clear any partial extract first (we only get here without the sentinel).
      os.remove.all(lib)
      os.proc("tar", "-xzf", tarball.toString, "-C", root.toString).call()
      os.remove(tarball) // reclaim ~43 MB; the sentinel guards against re-fetching
      os.write(sentinel, "")
      lib

  // Content-fingerprints the fork's jars so a rebuilt or re-released compiler regenerates the
  // repository. `SOUNDNESS_SCALA_HOME` (if set) points at a local `release`; otherwise the
  // `settings.scalaRelease` assets are downloaded and cached.
  def distribution: T[PathRef] = Task.Input:
    if settings.scalaHome.nonEmpty then PathRef(os.Path(settings.scalaHome) / "lib")
    else PathRef(downloadRelease(settings.scalaRelease))

  def repo: T[PathRef] = Task:
    val lib = distribution().path
    val v = settings.scalaVersion
    val sl = "org.scala-lang"

    // (group, artifactId, jar filename in release/lib, dependencies as (group, id, version))
    val artifacts = Seq(
      // The fork's supplementary runtime (since 3.9.0-p16): shipped as its own jar so
      // `scala-library` stays byte-identical to upstream's build, and declared as a
      // dependency of `scala-library` so it rides along wherever the stdlib goes —
      // exactly as in the Soundness build's toolchain repository.
      (sl, "proscala-library_3", "proscala-library.jar", Seq()),
      (sl, "scala-library", "scala-library.jar", Seq((sl, "proscala-library_3", v))),
      (sl, "scala3-library_3", "scala3-library.jar", Seq((sl, "scala-library", v))),
      (sl, "scala3-interfaces", "scala3-interfaces.jar", Seq()),
      (sl, "tasty-core_3", "tasty-core.jar", Seq((sl, "scala-library", v))),
      (sl, "scala3-compiler_3", "scala3-compiler.jar", Seq(
        (sl, "scala3-interfaces", v),
        (sl, "tasty-core_3", v),
        (sl, "scala3-library_3", v),
        ("org.scala-lang.modules", "scala-asm", "9.9.0-scala-1"),
        ("org.scala-sbt", "compiler-interface", "1.12.0"),
        ("org.scala-sbt", "util-interface", "1.11.5"))),
      (sl, "scala3-repl_3", "scala3-repl.jar", Seq(
        (sl, "scala3-compiler_3", v),
        ("org.jline", "jline-reader", "4.0.14"),
        ("org.jline", "jline-terminal", "4.0.14"),
        ("org.jline", "jline-terminal-jni", "4.0.14"),
        ("io.get-coursier", "interface", "1.0.29-M4"),
        ("org.virtuslab", "using_directives", "1.1.4"),
        ("com.lihaoyi", "pprint_3", "0.9.3"))),
      (sl, "scala3-sbt-bridge", "scala3-sbt-bridge.jar", Seq(
        (sl, "scala3-compiler_3", v),
        (sl, "scala3-repl_3", v))),
      (sl, "scala3-staging_3", "scala3-staging.jar", Seq((sl, "scala3-compiler_3", v))),
      (sl, "scala3-tasty-inspector_3", "scala3-tasty-inspector.jar", Seq(
        (sl, "scala3-compiler_3", v))))

    artifacts.map: (group, id, jar, dependencies) =>
      val dir = Task.dest / os.SubPath(group.replace('.', '/')) / id / v
      os.makeDir.all(dir)
      os.copy(lib / jar, dir / s"$id-$v.jar", replaceExisting = true)

      val deps = dependencies.map: (dGroup, dId, dVersion) =>
        s"<dependency><groupId>$dGroup</groupId><artifactId>$dId</artifactId>" +
          s"<version>$dVersion</version></dependency>"
      . mkString

      os.write.over(dir / s"$id-$v.pom",
        s"""<?xml version="1.0" encoding="UTF-8"?>
           |<project xmlns="http://maven.apache.org/POM/4.0.0">
           |  <modelVersion>4.0.0</modelVersion>
           |  <groupId>$group</groupId>
           |  <artifactId>$id</artifactId>
           |  <version>$v</version>
           |  <dependencies>$deps</dependencies>
           |</project>
           |""".stripMargin)

    PathRef(Task.dest)

// Routes a Scala module through the fork toolchain: the repository view above for all coursier
// resolutions, plus direct (content-hashed) paths for the two hot artifacts — the compiler
// classpath and the compiled sbt bridge — so a rebuilt compiler is picked up without any
// version-string ceremony.
trait Toolchain extends ScalaModule:
  override def repositories: T[Seq[String]] = Task:
    super.repositories() :+ s"file://${toolchain.repo().path}"

  // The Soundness bundle POMs name the fork toolchain at the version Soundness itself was built
  // with — `soundness-base`/`-test`/`-tool` all pin `scala-library`, `scala3-compiler_3` and
  // `scala3-staging_3`, and `soundness-tool` also `scala3-tasty-inspector_3`. The synthetic
  // repository above only ever contains `settings.scalaVersion`, and no fork version exists on
  // Central, so any pin that differs from ours is unresolvable. Forcing them all to
  // `settings.scalaVersion` is what lets flame be built by a compiler from a *different* proscala
  // stream than the one that produced the Soundness jars.
  override def depManagement: T[Seq[Dep]] = Task:
    super.depManagement() ++ Seq(
      mvn"org.scala-lang:proscala-library_3:${settings.scalaVersion}",
      mvn"org.scala-lang:scala-library:${settings.scalaVersion}",
      mvn"org.scala-lang:scala3-library_3:${settings.scalaVersion}",
      mvn"org.scala-lang:scala3-interfaces:${settings.scalaVersion}",
      mvn"org.scala-lang:tasty-core_3:${settings.scalaVersion}",
      mvn"org.scala-lang:scala3-compiler_3:${settings.scalaVersion}",
      mvn"org.scala-lang:scala3-staging_3:${settings.scalaVersion}",
      mvn"org.scala-lang:scala3-tasty-inspector_3:${settings.scalaVersion}")

  override def scalaCompilerClasspath: T[Seq[PathRef]] = Task:
    // The fork-built jars come from the repository view because Zinc locates the standard
    // library within this classpath BY FILENAME (`scala-library-<version>*.jar`), and the
    // distribution's own filenames are unversioned. The compiler's own third-party runtime
    // dependencies (scala-asm for bytecode, the sbt compiler/util interfaces for the bridge) are
    // not shipped in the release, so they are resolved from the ordinary repositories.
    val versioned = os.walk(toolchain.repo().path).filter(_.ext == "jar").map(PathRef(_))
    val thirdParty = defaultResolver().classpath(Seq(
      mvn"org.scala-lang.modules:scala-asm:9.9.0-scala-1",
      mvn"org.scala-sbt:compiler-interface:1.12.0",
      mvn"org.scala-sbt:util-interface:1.11.5"))

    versioned ++ thirdParty

  override def scalaCompilerBridge: T[Option[PathRef]] = Task:
    Some(PathRef(toolchain.distribution().path / "scala3-sbt-bridge.jar"))

trait Project extends Module:
  def moduleDir = super.moduleDir / os.up / "src"

// Dependencies are typed `PublishModule*` (as in the Soundness build) so that `moduleDeps` can
// return `Seq[PublishModule]` — the type `SonatypeCentralPublishModule` requires of the modules that
// mix in `Publishing`. All of flame's inter-module dependencies (`core`, `web`) are published, so
// this costs the unpublished modules (`launcher`, `test`) nothing.
trait Component(dependencies: PublishModule*) extends Toolchain:
  override def scalaVersion = settings.scalaVersion
  override def scalacOptions = settings.scalaOptions ++ settings.predef

  // The beneficence plugin writes `META-INF/givens/<typeclass>` and `META-INF/services/probably.Suite`
  // into every module that contributes an entry, so each is a *fragment* of a build-wide index rather
  // than a whole file. Mill's default assembly rules are last-one-wins, which silently truncates them:
  // now that flame's Soundness dependency arrives as eight bundle jars — which collide on 66 such
  // entries — the givens index would lose almost everything, and `beneficence` reads it at runtime
  // through `getResources`. Concatenate instead, exactly as the Soundness build does (`mergeRules`).
  // Every fragment ends with a newline, so the empty separator is correct.
  override def assemblyRules = super.assemblyRules ++ Seq(
    mill.javalib.Assembly.Rule.AppendPattern("META-INF/givens/.*"),
    mill.javalib.Assembly.Rule.AppendPattern("META-INF/services/.*"))
  def moduleId: String = moduleDir.last
  def moduleDeps: Seq[PublishModule] = dependencies
  def sources = Task.Sources(moduleDir)

// Mixed into the library modules that are released (`core`, `web`, `client`) — the modules the
// `launcher` then pulls back in as published coordinates. Releases go to GitHub Releases (see
// etc/ci/release.sh), with `publishLocal` producing the jars and their POMs; the Sonatype module is
// retained only for its POM machinery. Every setting mirrors the Soundness build: the same
// `dev.propensive` organization, URL, Apache-2.0 licence, GitHub SCM and developer, plus the empty
// `-javadoc.jar`. A module's `moduleDeps` that are themselves `Publishing` become POM
// `<dependency>` entries, so the published `flame-client` correctly declares `flame-core`/`flame-web`.
trait Publishing extends Toolchain, SonatypeCentralPublishModule:
  def publishVersion = settings.flameVersion
  def artifactSuffix = Task("")

  def pomSettings = Task(PomSettings(
    description = "flame",
    organization = "dev.propensive",
    url = "https://soundness.dev/",
    licenses = Seq(License.`Apache-2.0`),
    versionControl = VersionControl.github("propensive", "flame"),
    developers = Seq(Developer("propensive", "Jon Pretty", "https://github.com/propensive"))))

  override def docJar = Task:
    val jar = Task.dest / "empty.jar"
    val zos = new java.util.zip.ZipOutputStream(new java.io.FileOutputStream(jar.toIO))
    zos.close()
    PathRef(jar)

object flame extends Project:
  // The REPL engine. Depends on the Scala 3 compiler (it compiles user input) in addition to its
  // Soundness components. Released as `dev.propensive:flame-core`.
  object core extends Component(), Publishing:
    def mvnDeps =
      settings.coreDeps ++ settings.pyrocosmCoreDeps :+ mvn"org.scala-lang:scala3-compiler_3:${settings.scalaVersion}"

    // frontier — `soundness.explainMissingContext`, the `@internal.diagnostic` catch-all given
    // that renders Soundness's missing-given advice — is a RUNTIME dependency only: it must be on
    // the REPL session classpath (which is this module's runtime classpath), but flame's own
    // sources have no use for it at compile time. (Before Soundness 0.65.0 it also had to be kept
    // OFF the compile classpath, where the catch-all satisfied tentative implicit searches —
    // `join`'s element type, `flatMap`'s reshaping — with `Any`; Soundness #1944 made the candidate
    // always fail, so that hazard is gone, but there is still no reason to compile against it.)
    def runMvnDeps = Seq(settings.component("frontier-core"))

  // The interactive client library (`flame.runClient` and its helpers). NO LONGER an assembled app:
  // the `@main`/`externalize` entry point moved to the `launcher` module, so this is a plain library
  // released as `dev.propensive:flame-client`. Depends on `core` and `web` (so
  // `flame serve` can launch the web front-end in-process); those become `flame-core`/`flame-web`
  // POM dependencies, and the web front-end's Soundness deps come transitively.
  object client extends Component(core, web), Publishing:
    def mvnDeps = settings.clientDeps :+ mvn"dev.propensive:pyrocosm-terminal:${settings.pyrocosmVersion}"

  // An alternative, web-based front-end (`flame.web`): serves a page and forwards REPL input/output
  // over a WebSocket, driving the same `core` engine as the CLI client. Published as
  // `dev.propensive:flame-web`; still assembled directly by `make web`, hence `finalMainClass`.
  object web extends Component(core), Publishing:
    def mvnDeps = settings.webDeps :+ mvn"dev.propensive:pyrocosm-web:${settings.pyrocosmVersion}"
    def finalMainClass = "flame.web"
    def prependShellScript = ""

  // The invocation point, ALONE in its own module (`src/launcher/flame_launcher.scala` — just the
  // `@main def repl = externalize(runClient())`). It depends on `client`/`core`/`web` NOT as Mill
  // `moduleDeps` but as PUBLISHED coordinates, so coursier puts the byte-identical released jars
  // on the compile classpath that `externalize` hashes; the repackager then externalizes them into
  // on-demand downloads instead of inlining. `flame-client`'s POM pulls `flame-core`/`flame-web`
  // (and the Soundness components) transitively; burdock is also named explicitly because the
  // `externalize` macro and the `soundness.repackage` main are compiled/run against it.
  //
  // NOTE: `flame-client` resolves from `~/.ivy2/local`, so a `publishLocal` must precede this
  // module's assembly (`make run` does so). Externalization happens only in `make release`, once
  // the same bytes are a GitHub release asset (a local copy alone would be inlined).
  object launcher extends Component():
    def mvnDeps =
      mvn"dev.propensive:flame-client:${settings.flameVersion}" +: settings.clientDeps
    def finalMainClass = "flame.repl"
    // A clean zip (no executable shell preamble) so the Burdock repackager can read and rewrite the
    // assembled JAR.
    def prependShellScript = ""

  // The beneficence plugin runs on this module so that its `Suite` lands in the assembly's
  // `META-INF/services/probably.Suite` index, which is how `fume run` (configured by
  // .fume/config.tel) discovers it. `flame.runTests` is the plain-`java` fallback the shared CI
  // workflow uses, driving `Tests.invoke` in-process.
  object test extends Component(core):
    def mvnDeps = settings.testDeps
    def scalacPluginMvnDeps = Seq(mvn"dev.propensive:beneficence-plugin:${settings.soundnessVersion}")
    def finalMainClass = "flame.runTests"
